{
  "name": "inline-discussion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone HTTP inline-discussion server: live markdown preview plus threaded AI conversations on a single document.",
  "bin": {
    "inline-discussion": "bin/inline-discussion"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "bin/inline-discussion",
    "test": "node --import tsx/esm --test --test-concurrency=1 'test/*.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@hono/node-server": "2.0.12",
    "hono": "4.12.34",
    "fast-uri": "4.1.2",
    "ip-address": "10.3.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.141",
    "dompurify": "3.4.12",
    "highlight.js": "11.9.0",
    "isomorphic-dompurify": "2.9.0",
    "jsdom": "24.0.0",
    "marked": "12.0.2",
    "mermaid": "11.16.1"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.6",
    "@types/node": "20.19.41",
    "esbuild": "0.28.0",
    "tsx": "4.7.2",
    "typescript": "5.4.5"
  }
}
