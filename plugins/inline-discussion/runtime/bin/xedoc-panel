#!/usr/bin/env python3
import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import sys

runtime = Path(__file__).resolve().parent.parent
fingerprint = hashlib.sha256(
    (runtime / "package.json").read_bytes() + (runtime / "package-lock.json").read_bytes()
).hexdigest()
marker = runtime / "node_modules/.xedoc-panel-lock"
prepared = marker.exists() and marker.read_text() == fingerprint
bundle = runtime / "dist/hosted-panel.js"
fresh = bundle.exists() and all(
    path.stat().st_mtime <= bundle.stat().st_mtime
    for path in [runtime / "esbuild.config.mjs", *runtime.glob("src/**/*")]
    if path.is_file()
)
try:
    node = shutil.which("node")
    npm = shutil.which("npm")
    if not node or not npm:
        raise OSError("Node >=20 and npm must be on PATH")
    if not prepared or not fresh:
        if not prepared:
            print("Inline Discussion: preparing pinned plugin dependencies…", file=sys.stderr)
            subprocess.run(
                [npm, "ci", "--no-audit", "--no-fund", "--include=dev", "--ignore-scripts"],
                cwd=runtime, stdout=sys.stderr, check=True,
            )
        subprocess.run([npm, "run", "--silent", "build"], cwd=runtime, stdout=sys.stderr, check=True)
        marker.write_text(fingerprint)
    if sys.argv[1:] == ["--prepare"]:
        raise SystemExit(0)
    os.execv(node, [node, str(bundle)])
except (OSError, subprocess.CalledProcessError) as error:
    print(f"Inline Discussion runtime unavailable: {error}. Node >=20 and npm are required.", file=sys.stderr)
    raise SystemExit(5)
