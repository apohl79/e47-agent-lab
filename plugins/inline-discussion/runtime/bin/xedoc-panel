#!/usr/bin/env python3
import os
from pathlib import Path
import shutil
import sys

runtime = Path(__file__).resolve().parent.parent
try:
    node = shutil.which("node")
    if not node:
        raise OSError("Node >=20 must be on PATH")
    args = [] if sys.argv[1:] == ["--prepare"] else ["--hosted-panel"]
    os.execv(node, [node, str(runtime / "bin/prepare-runtime.mjs"), *args])
except OSError as error:
    print(f"Inline Discussion runtime unavailable: {error}. Node >=20 and npm are required.", file=sys.stderr)
    raise SystemExit(5)
